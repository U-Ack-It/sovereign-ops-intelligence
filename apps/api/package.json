{
  "name": "sovereign-ops-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "bug:sentinel": "node scripts/bug-sentinel.mjs",
    "check:production": "node scripts/check-production-config.mjs",
    "gate:2": "npm run bug:sentinel",
    "guard": "node scripts/bug-guardian.mjs",
    "guardian": "node scripts/guardian.mjs",
    "smoke": "npm run build && node scripts/smoke-route.mjs",
    "smoke:production": "node scripts/smoke-production-start.mjs",
    "smoke:route": "npm run smoke",
    "smoke:execute": "node scripts/smoke-execute.mjs",
    "start": "node dist/server.js",
    "sentinel": "npm run bug:sentinel",
    "test": "npm run test:agents",
    "test:agents": "rm -rf .tmp-test-build && tsc -p tsconfig.test.json && node --test \".tmp-test-build/**/*.test.js\" \"scripts/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test:agents && npm run smoke",
    "verify:guardian": "npm run verify && npm run guardian",
    "verify:production": "npm run build && NODE_ENV=production npm run check:production && NODE_ENV=test SOVEREIGN_ADMIN_API_KEY= npm run sentinel && npm run smoke:production",
    "verify:sentinel": "npm run verify && npm run sentinel"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.9.3"
  }
}
